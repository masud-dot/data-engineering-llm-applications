# Settings for the airflow service. Secrets come from .env instead.
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__PARALLELISM=4
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2:///airflow
AIRFLOW__CORE__LOAD_EXAMPLES=False
AIRFLOW__CORE__DAGS_ARE_PAUSED_AT_CREATION=False
AIRFLOW__DAG_PROCESSOR__REFRESH_INTERVAL=30
AIRFLOW__API__WORKERS=1
AIRFLOW__CORE__SIMPLE_AUTH_MANAGER_ALL_ADMINS=True
PYTHONPATH=/opt/llmdata/src
LLMDATA_DATA_DIR=/opt/llmdata/data
LLMDATA_PIPELINES_DIR=/opt/llmdata/pipelines
LLMDATA_MODEL_DIR=/opt/llmdata/models
